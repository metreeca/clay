{
  "entryPoints": [
    "packages/*"
  ],
  "entryPointStrategy": "packages",
  "name": "@metreeca/clay",
  "out": "docs",
  "readme": "README.md",
  "hostedBaseUrl": "https://metreeca.github.io/clay/",
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://metreeca.com/assets/icon.ico",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "externalSymbolLinkMappings": {
    "global": {
      "Error": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "RangeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/RangeError",
      "SyntaxError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/SyntaxError",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError"
    },
    "typescript": {
      "Error": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "RangeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/RangeError",
      "SyntaxError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/SyntaxError",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError"
    },
    "@metreeca/core": {
      "*": "https://metreeca.github.io/core/"
    },
    "@metreeca/http": {
      "*": "https://metreeca.github.io/http/"
    },
    "@metreeca/skin": {
      "*": "https://metreeca.github.io/skin/"
    },
    "preact": {
      "*": "https://preactjs.com/guide/v10/api-reference/"
    }
  },
  "navigationLinks": {
    "GitHub": "https://github.com/metreeca/clay"
  },
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://metreeca.com/assets/icon.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2023-2026 Metreeca</span></a>",
  "headings": {
    "readme": false
  },
  "highlightLanguages": [
    "shell",
    "typescript",
    "tsx",
    "css",
    "html"
  ],
  "packageOptions": {
    "entryPoints": [
      "src/**/*.{ts,tsx}"
    ],
    "exclude": [
      "**/packages/clay-widgets/src/glyphs/icon.core.ts",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test-d.ts"
    ],
    "tsconfig": "./tsconfig.build.json",
    "excludeExternals": true,
    "includeVersion": true,
    "sortEntryPoints": false,
    "sort": [
      "source-order"
    ],
    "categorizeByGroup": true,
    "groupOrder": [
      "Variables",
      "Interfaces",
      "Type Aliases",
      "Properties",
      "Methods",
      "*"
    ]
  }
}
