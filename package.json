{
  "private": true,
  "version": "0.1.0",
  "description": "Minimalist UI toolkit for Preact.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "specimen"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces && ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "npm run build --workspaces && ush rm docs && npx typedoc",
    "check": "npm run check --workspaces --if-present",
    "proof": "npm run build && npx wds --root-dir docs --open",
    "watch": "npm run watch -w specimen"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.6.0",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.20",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
