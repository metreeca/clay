  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules '*.tsbuildinfo'",
    "build": "tsc -b tsconfig.build.json && ush cp dist 'src/**/*.css' 'src/**/*.md'",
    "check": "npx vitest --config ../../vitest.config.ts --root . --typecheck --passWithNoTests run"
  },
  "dependencies": {
    "@metreeca/clay": "^0.1.0",
    "@metreeca/core": "^0.13.0",
    "@metreeca/skin": "^0.1.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "lucide-preact": "^1.47.0",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
