{
  "name": "@metreeca/clay-widgets",
  "version": "0.1.0",
  "description": "Preact widgets and layouts for @metreeca/clay.",
  "keywords": [
    "typescript",
    "preact",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/clay/",
  "bugs": {
    "url": "https://github.com/metreeca/clay/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/clay.git",
    "directory": "packages/clay-widgets"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/icon.js"
  ],
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./icon": {
      "@metreeca/source": "./src/glyphs/icon.ts",
      "default": "./dist/glyphs/icon.js"
    },
    "./icon.css": {
      "@metreeca/source": "./src/glyphs/icon.css",
      "default": "./dist/glyphs/icon.css"
    },
    "./logo": {
      "@metreeca/source": "./src/glyphs/logo.tsx",
      "default": "./dist/glyphs/logo.js"
    },
    "./logo.css": {
      "@metreeca/source": "./src/glyphs/logo.css",
      "default": "./dist/glyphs/logo.css"
    },
    "./button": {
      "@metreeca/source": "./src/controls/button.tsx",
      "default": "./dist/controls/button.js"
    },
    "./button.css": {
      "@metreeca/source": "./src/controls/button.css",
      "default": "./dist/controls/button.css"
    },
    "./choice": {
      "@metreeca/source": "./src/controls/choice.tsx",
      "default": "./dist/controls/choice.js"
    },
