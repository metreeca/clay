    "./guard.css": {
      "@metreeca/source": "./src/content/guard.css",
      "default": "./dist/content/guard.css"
    },
    "./hint": {
      "@metreeca/source": "./src/content/hint.tsx",
      "default": "./dist/content/hint.js"
    },
    "./hint.css": {
      "@metreeca/source": "./src/content/hint.css",
      "default": "./dist/content/hint.css"
    },
    "./info": {
      "@metreeca/source": "./src/content/info.tsx",
      "default": "./dist/content/info.js"
    },
    "./info.css": {
      "@metreeca/source": "./src/content/info.css",
      "default": "./dist/content/info.css"
