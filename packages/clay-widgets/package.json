      "@metreeca/source": "./src/controls/choice.css",
      "default": "./dist/controls/choice.css"
    },
    "./link": {
      "@metreeca/source": "./src/controls/link.tsx",
      "default": "./dist/controls/link.js"
    },
    "./link.css": {
      "@metreeca/source": "./src/controls/link.css",
      "default": "./dist/controls/link.css"
    },
    "./more": {
      "@metreeca/source": "./src/controls/more.tsx",
      "default": "./dist/controls/more.js"
    },
    "./more.css": {
      "@metreeca/source": "./src/controls/more.css",
      "default": "./dist/controls/more.css"
    },
    "./note": {
      "@metreeca/source": "./src/controls/note.tsx",
      "default": "./dist/controls/note.js"
    },
    "./note.css": {
      "@metreeca/source": "./src/controls/note.css",
      "default": "./dist/controls/note.css"
    },
    "./path": {
      "@metreeca/source": "./src/controls/path.tsx",
      "default": "./dist/controls/path.js"
    },
    "./path.css": {
      "@metreeca/source": "./src/controls/path.css",
      "default": "./dist/controls/path.css"
    },
    "./toc": {
      "@metreeca/source": "./src/controls/toc.tsx",
      "default": "./dist/controls/toc.js"
    },
    "./toc.css": {
      "@metreeca/source": "./src/controls/toc.css",
      "default": "./dist/controls/toc.css"
    },
    "./box": {
      "@metreeca/source": "./src/layouts/box.tsx",
      "default": "./dist/layouts/box.js"
    },
    "./box.css": {
      "@metreeca/source": "./src/layouts/box.css",
      "default": "./dist/layouts/box.css"
    },
    "./section": {
      "@metreeca/source": "./src/layouts/section.tsx",
