{
  "name": "@metreeca/clay",
  "version": "0.1.0",
  "description": "Preact contexts and hooks for @metreeca/clay.",
  "keywords": [
    "typescript",
    "preact",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/clay/",
  "bugs": {
    "url": "https://github.com/metreeca/clay/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/clay.git",
    "directory": "packages/clay"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./asset": {
      "@metreeca/source": "./src/asset.ts",
      "default": "./dist/asset.js"
    },
    "./board": {
      "@metreeca/source": "./src/board.ts",
      "default": "./dist/board.js"
    },
    "./fetch": {
      "@metreeca/source": "./src/fetch.ts",
      "default": "./dist/fetch.js"
    },
    "./model": {
      "@metreeca/source": "./src/model.ts",
      "default": "./dist/model.js"
    },
    "./router": {
      "@metreeca/source": "./src/router.ts",
      "default": "./dist/router.js"
    },
    "./focus": {
      "@metreeca/source": "./src/focus.ts",
      "default": "./dist/focus.js"
    },
    "./storage": {
      "@metreeca/source": "./src/storage.ts",
      "default": "./dist/storage.js"
    },
    "./transfer": {
      "@metreeca/source": "./src/transfer.ts",
      "default": "./dist/transfer.js"
    },
    "./*.core": null
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules '*.tsbuildinfo'",
    "build": "tsc -b tsconfig.build.json",
    "check": "npx vitest --config ../../vitest.config.ts --root . --typecheck --passWithNoTests run"
  },
  "dependencies": {
    "@metreeca/core": "^0.13.0",
    "@metreeca/http": "^0.5.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "preact": "^10.27.2"
  }
}
