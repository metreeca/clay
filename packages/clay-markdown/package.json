{
  "name": "@metreeca/clay-markdown",
  "version": "0.1.0",
  "description": "Preact Markdown documents for @metreeca/clay.",
  "keywords": [
    "typescript",
    "preact",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/clay/",
  "bugs": {
    "url": "https://github.com/metreeca/clay/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/clay.git",
    "directory": "packages/clay-markdown"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./*": {
      "@metreeca/source": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.css": {
      "@metreeca/source": "./src/*.css",
      "default": "./dist/*.css"
    },
    "./*.core": null
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules '*.tsbuildinfo'",
    "build": "tsc -b tsconfig.build.json && ush cp dist 'src/*.css'",
    "check": "npx vitest --config ../../vitest.config.ts --root . --typecheck --passWithNoTests run"
  },
  "dependencies": {
    "@metreeca/clay-widgets": "^0.1.0",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "happy-dom": "^21.0.4",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "preact": "^10.27.2"
  }
}
